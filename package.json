{
  "name": "emoji-mahjong",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/cache-shell.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:engine && npm run test:worker",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "check": "npm run lint && npm run build && npm run typecheck:worker && npm test",
    "test:engine": "node scripts/run-engine-tests.mjs",
    "test:worker": "node scripts/test-worker.mjs && node scripts/test-mixed-exit.mjs",
    "test:browser": "playwright test",
    "dev:worker": "wrangler dev --local --ip 127.0.0.1 --port 8787"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "framer-motion": "^12.38.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "miniflare": "4.20260317.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.3.0",
    "wrangler": "^4.75.0"
  }
}
